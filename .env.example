# Copia este archivo como .env y reemplaza todos los valores CHANGE_ME.
# El proyecto solo admite el portal local de demostracion.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=appointment_demo
DB_USER=appointment_demo
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ROOT_PASSWORD

API_TOKEN=CHANGE_ME_WITH_AT_LEAST_24_RANDOM_CHARACTERS
DEMO_ACCESS_CODE=CHANGE_ME_LOCAL_DEMO_CODE
DEMO_PORTAL_BASE_URL=http://127.0.0.1:5000/demo

WORKER_POLL_SECONDS=10
WORKER_MAX_ATTEMPTS=3
SELENIUM_HEADLESS=true
LOG_LEVEL=INFO
